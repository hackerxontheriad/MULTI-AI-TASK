{
  "name": "MAD X Hybrid AI Studio",
  "version": "17.0.0",
  "release_date": "2026-10-26",
  "description": "Merged free-first hybrid AI studio based on the two user-supplied project archives; includes new animated landing page, legacy assets, connector setup and Android wrapper source.",
  "verification": {
    "pytest": "77 passed (offline suite)",
    "python_compile": "passed for core runtime, router and utility modules",
    "javascript_syntax": "passed for static/app.js, static/landing.js and static/diagnostics.js",
    "http_routes": "smoke-tested with FastAPI TestClient; connector status auth gate tested",
    "github_upstream_fetch": "not performed: outbound GitHub DNS/network unavailable",
    "live_provider_requests": "not performed",
    "google_oauth_end_to_end": "not performed",
    "tsx_build": "not performed: packages unavailable offline; source included",
    "android_apk": "not built or signed: Android SDK and Gradle unavailable",
    "docker_build": "not performed",
    "real_hosted_image_or_video_generation": "not verified",
    "security_certification": "not performed"
  },
  "features": [
    "v16.1 single-route FastAPI backend retained and versioned as 17.0.0",
    "Six-agent task pipeline with planner, researcher, builder, reviewer, optimizer and tester roles",
    "Verified Google ID-token login scaffolding, encrypted HttpOnly sessions, optional email allowlist and app bearer token mode",
    "Separate admin-only diagnostics password and authenticated connector status with optional gateway probes",
    "Animated emerald/glass/metallic-gold landing page at / with original landing archived under legacy/static",
    "Both old/new SVG logo paths, both icon PNG paths and original logo-demo.mp4 preserved",
    "Code blocks with Copy and Download; HTML/SVG Run and Preview in a sandboxed iframe",
    "Configurable OmniRoute, 9Router scaffold, New-API and One-API OpenAI-compatible gateway entries",
    "OmniRoute MCP client example and setup guide; no token is hard-coded or automatically minted",
    "Android wrapper Gradle/Java/manifest/resources source; APK not compiled",
    "HTML, Java, PHP and Python preview runner examples",
    "Static ZIP/APK/AAB source inventory utility that does not execute archive contents",
    "External repository registry, license/dependency notes and opt-in shallow fetch script"
  ],
  "source_archives": [
    "madex-hybrid.zip",
    "MAD-X-Hybrid-Studio-v16.1.zip"
  ],
  "notes": [
    "External repositories are listed but their entire source trees are not bundled because GitHub access failed in the build environment and separate project dependency/license requirements need review.",
    "TSX and minification do not make browser-delivered code impossible to inspect; secrets remain server-side.",
    "Configured connectors are not necessarily reachable or entitled to run a model; quotas and terms are governed by each provider."
  ],
