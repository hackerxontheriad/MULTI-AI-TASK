# Protect your own deployed MADEX gateway. This is not a provider API key.
API_ACCESS_TOKEN=

# Official provider API keys (optional; set only for services you intend to use).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Alternative Google key variable accepted by the Gemini adapter:
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
META_MODEL_API_KEY=
# Meta's Model API also accepts the variable name documented by Meta:
MODEL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional if Ollama is running somewhere other than this machine's default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Keyless community catalog settings.
G4F_WORKING_RESULTS_URLS=https://raw.githubusercontent.com/Free-AI-Things/g4f-working/main/working/working_results.txt,https://raw.githubusercontent.com/maruf009sultan/g4f-working/refs/heads/main/working/working_results.txt
CATALOG_TTL_SECONDS=900
G4F_REQUEST_TIMEOUT=60
G4F_MAX_WORKERS=4
LOG_LEVEL=INFO
