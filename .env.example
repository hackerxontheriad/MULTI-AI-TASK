# MAD X gateway security. Keep all real values in .env / host environment only.
# Generate an independent app token: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_ACCESS_TOKEN=
REQUIRE_LOGIN=true
# Independent password for hidden admin diagnostics; never reuse the app token.
DIAGNOSTICS_PASSWORD=
# Google Web OAuth client ID is public; configure the site's origin in Google Cloud.
GOOGLE_CLIENT_ID=
# Optional comma-separated email allowlist. Empty means any Google account with verified email can sign in.
ALLOWED_LOGIN_EMAILS=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
SESSION_DAYS=30
COOKIE_SECURE=true
# Task pipeline only: free route first, then optional keyed fallback if no distinct free route is ready.
FREE_FALLBACK_MODEL=
# Explicit API-key/proxy route used only as backup; example: OpenAI API|gpt-4.1-mini
PAID_FALLBACK_MODEL=
MAX_UPLOAD_MB=25

# ---- FREE-TIER routes (recommended; no card needed at the time of writing) ----
GROQ_API_KEY=               # https://console.groq.com/keys
CEREBRAS_API_KEY=           # https://cloud.cerebras.ai/
MISTRAL_API_KEY=            # https://console.mistral.ai/api-keys  (Experiment plan)
GEMINI_API_KEY=             # https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted)
GOOGLE_API_KEY=
GITHUB_MODELS_TOKEN=        # fine-grained GitHub token with models:read (GITHUB_TOKEN also accepted)
HF_TOKEN=                   # https://huggingface.co/settings/tokens (Inference Providers permission)
CLOUDFLARE_API_TOKEN=       # Workers AI token
CLOUDFLARE_ACCOUNT_ID=      # hex account id from the Cloudflare dashboard (needed with the token)
POLLINATIONS_API_KEY=       # https://enter.pollinations.ai (text + image)

# ---- Paid / other official APIs (optional) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
META_MODEL_API_KEY=
MODEL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# ---- Optional user-managed OpenAI-compatible proxies ----
# Use only endpoints you control or are authorized to access. These are not bundled public services.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODELS=openai/gpt-4o-mini
PAWANOSMAN_BASE_URL=
PAWANOSMAN_API_KEY=
PAWANOSMAN_MODELS=default
# ---- Separate OpenAI-compatible gateways (host/deploy separately) ----
# OmniRoute: default standalone gateway URL; use your real deployed URL in production.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=if/kimi-k2-thinking
# Only use the following when you have an authorized running service and have verified its API.
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODELS=default
NEW_API_BASE_URL=
NEW_API_API_KEY=
NEW_API_MODELS=default
ONE_API_BASE_URL=
ONE_API_API_KEY=
ONE_API_MODELS=default

# ---- Local open-source models (zero cost) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=             # Optional bearer key for an authorized hosted Ollama endpoint

# ---- Community (g4f) catalog + runtime ----
G4F_WORKING_RESULTS_URLS=https://raw.githubusercontent.com/Free-AI-Things/g4f-working/main/working/working_results.txt,https://raw.githubusercontent.com/maruf009sultan/g4f-working/refs/heads/main/working/working_results.txt
CATALOG_TTL_SECONDS=900
G4F_REQUEST_TIMEOUT=60
G4F_MAX_WORKERS=4
LOG_LEVEL=INFO

# ---- Networking / browser / limits ----
# CA_BUNDLE=/path/to/ca.pem      # only if you are behind a proxy with its own CA; TLS verification is never disabled
# CHROME_BIN=/usr/bin/chromium   # leave unset to auto-detect a real binary
# BROWSER_NO_SANDBOX=auto        # auto = add --no-sandbox when root/in Docker; 1 = always; 0 = never
RATE_LIMIT_PER_MIN=30            # per client; 0 disables
# TRUST_PROXY=1                  # honour X-Forwarded-For when behind Render/Nginx
# Public canonical origin (used for robots/sitemap); set to your deployed HTTPS URL.
PUBLIC_SITE_URL=
