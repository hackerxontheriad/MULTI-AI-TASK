# MADX Hybrid Studio v18 — keep secrets in host environment / .env only.
# Generate app/admin tokens independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
ADMIN_SESSION_HOURS=8
REQUIRE_LOGIN=true
COOKIE_SECURE=true
SESSION_DAYS=30
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
# Optional comma-separated list of verified Google emails allowed to sign in.
ALLOWED_LOGIN_EMAILS=
PUBLIC_SITE_URL=
# Hosted deployments: set DATABASE_URL to a persistent PostgreSQL URL. Local SQLite is the fallback.
DATABASE_URL=
# Local runs use ./data. Render free storage is ephemeral; set /tmp/madx-data there.
MADX_DATA_DIR=./data
# Free Edition: explicit single-model requests; never silently fall back.
MADX_FREE_EDITION=true
MADX_DISABLE_FALLBACK=true
FREE_FALLBACK_MODEL=
PAID_FALLBACK_MODEL=
MADX_DEFAULT_MODEL=
PROVIDER_REQUEST_TIMEOUT=60
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MIN=30
TRUST_PROXY=1
LOG_LEVEL=INFO
CATALOG_TTL_SECONDS=900

# Free-tier / low-cost provider keys: availability, credits and terms vary by account and region.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GITHUB_MODELS_TOKEN=
HF_TOKEN=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
POLLINATIONS_API_KEY=

# Optional paid APIs. Keys are server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
META_MODEL_API_KEY=
MODEL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional user-managed OpenAI-compatible endpoints; use only endpoints you own or are authorized to access.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODELS=openai/gpt-4o-mini
PAWANOSMAN_BASE_URL=
PAWANOSMAN_API_KEY=
PAWANOSMAN_MODELS=default
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=if/kimi-k2-thinking
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODELS=default
NEW_API_BASE_URL=
NEW_API_API_KEY=
NEW_API_MODELS=default
ONE_API_BASE_URL=
ONE_API_API_KEY=
ONE_API_MODELS=default

# Local/self-hosted models; localhost on Render points to the Render container, not your home PC.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# Optional persistent file storage. Leave both values blank to use temporary local files.
# Store a one-line service-account JSON string in Render Environment; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
