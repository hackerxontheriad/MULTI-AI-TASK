# MADX Hybrid Studio Free Edition — copy to .env for local testing.
# Never commit real secrets. Set values in Render Environment instead.
MADX_FREE_EDITION=true
MADX_DISABLE_FALLBACK=true
FREE_FALLBACK_MODEL=
PAID_FALLBACK_MODEL=
REQUIRE_LOGIN=true
COOKIE_SECURE=true
SESSION_DAYS=30
ADMIN_SESSION_HOURS=8
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ALLOWED_LOGIN_EMAILS=your-admin-google-email@example.com
PUBLIC_SITE_URL=https://your-madx-service.onrender.com
API_ACCESS_TOKEN=generate-a-long-random-secret
ADMIN_ACCESS_TOKEN=generate-a-different-long-random-secret
SESSION_ENCRYPTION_KEY=generate-fernet-key
MADX_DEFAULT_MODEL=
MADX_DATA_DIR=/tmp/madx-data
DATABASE_URL=
# Optional free-tier provider keys; only configure services whose terms/quota you accept.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
POLLINATIONS_API_KEY=
# Hybrid local Ollama is optional. Render localhost is NOT your phone/PC.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Optional user-owned gateways. Leave blank until hosted and reachable over HTTPS.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODELS=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=
PAWANOSMAN_BASE_URL=
PAWANOSMAN_API_KEY=
PAWANOSMAN_MODELS=
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODELS=
NEW_API_BASE_URL=
NEW_API_API_KEY=
NEW_API_MODELS=
ONE_API_BASE_URL=
ONE_API_API_KEY=
ONE_API_MODELS=

# Optional persistent file storage. Leave both values blank to use temporary local files.
# Store a one-line service-account JSON string in Render Environment; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
